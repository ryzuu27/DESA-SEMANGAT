# Salin file ini menjadi ".env" lalu isi nilainya sebelum menjalankan server.

# Wajib diisi — teks acak yang panjang dan rahasia, dipakai untuk mengenkripsi sesi login.
# Contoh membuatnya di terminal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Port server (opsional, default 3000)
PORT=3000

# Akun admin awal, dibuat otomatis saat pertama kali server dijalankan (hanya jika belum ada pengguna).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set "true" HANYA jika situs diakses lewat HTTPS (misalnya sudah pasang domain + SSL).
# Jika masih diakses lewat http://alamat-ip-lokal, biarkan "false".
COOKIE_SECURE=false
